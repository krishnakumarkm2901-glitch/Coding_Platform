# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb://localhost:27017/college_coding_db

# Secret key for signing JWT tokens
JWT_SECRET=super_secure_jwt_random_secret_college_coding_2026

# Piston Code Execution API URL
PISTON_API_URL=https://emkc.org/api/v2/piston

# Optional local toolchain paths. Leave empty to auto-detect from PATH.
GCC_PATH=
GPP_PATH=
JAVAC_PATH=
JAVA_PATH=
GO_PATH=
RUSTC_PATH=
NODE_PATH=

# Server Port
PORT=5000

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Token Expiry (Hours)
JWT_EXPIRATION_HOURS=48
